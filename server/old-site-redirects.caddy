@oldWpPage expression {old_wp_page} != ""
redir @oldWpPage {old_wp_page} 301

# ---------- Served by the old WordPress (cPanel host 107.155.113.78) ----------
# Every /travel/... address that wasn't redirected above: the old pages, the doc and excursion pages (with their forms and
# rosters), WordPress's files, the form endpoint (wp-admin/admin-ajax.php), the admin and the login. Their own redirects
# (/doc/x -> /travel/doc/x, /excursion/x -> /travel/excursion/x) keep working too.
# Needs the cPanel hosting to stay active. The connection to WordPress is HTTPS with the normal certificate
# check. So cPanel can keep renewing that certificate (AutoSSL) after the domain points here, its domain
# checks under /.well-known/ are passed through as well (Caddy answers its own certificate checks first).
@wordpress path /travel/* /doc/* /excursion/* /.well-known/pki-validation/* /.well-known/acme-challenge/*
handle @wordpress {
    reverse_proxy https://107.155.113.78 {
        header_up Host worldschoolingjourneys.com
        transport http {
            tls_server_name worldschoolingjourneys.com
        }
    }
}
