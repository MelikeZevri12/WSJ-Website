@oldSite expression {old_site_target} != ""
redir @oldSite {old_site_target} 301

# An old page whose name is also a page on the new site (/travel/about/ -> /about, /travel/faq/ -> /faq...).
map {path} {old_page} {
        ~^/travel/([a-z0-9-]+)/?$                  /${1}
        default                                    ""
}
@oldSamePage {
    expression {old_page} != ""
    not path /travel/404* /travel/home* /travel/admin* /travel/booking-form* /travel/cruise-detail* /travel/journey*
    file {
        root /home/melike/apps/website
        try_files {old_page}.html
    }
}
redir @oldSamePage {old_page} 301
redir /travel / 301
redir /travel/ / 301

