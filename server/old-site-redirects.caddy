@oldSite expression {old_site_target} != ""
redir @oldSite {old_site_target} 301

# The old WordPress also answered under /travel/... (its install folder): /travel/excursion/x/ -> /excursion/x/,
# which the list above then sends on to the new page. /travel itself -> home page.
@oldTravel {
    path_regexp travel ^/travel(/.+)$
    not path /travel/doc/* /travel/excursion/* /travel/wp-content/* /travel/wp-includes/* /travel/wp-admin/* /travel/wp-json/* /travel/wp-login.php /travel/wp-cron.php
}
redir @oldTravel {re.travel.1} 301
redir /travel / 301
redir /travel/ / 301

# ---------- Still served by the old WordPress (cPanel host 107.155.113.78) ----------
# The doc and excursion pages (with their forms and rosters) stay on WordPress, at the same addresses.
# Their own redirects (/doc/x -> /travel/doc/x, /excursion/x -> /travel/excursion/x) keep working too,
# and so do WordPress's files, the form endpoint (wp-admin/admin-ajax.php), the admin and the login.
# Needs the cPanel hosting to stay active. The connection to WordPress is HTTPS with the normal certificate
# check. So cPanel can keep renewing that certificate (AutoSSL) after the domain points here, its domain
# checks under /.well-known/ are passed through as well (Caddy answers its own certificate checks first).
@wordpress path /travel/doc/* /travel/excursion/* /doc/* /excursion/* /travel/wp-content/* /travel/wp-includes/* /travel/wp-admin/* /travel/wp-json/* /travel/wp-login.php /travel/wp-cron.php /.well-known/pki-validation/* /.well-known/acme-challenge/*
handle @wordpress {
    reverse_proxy https://107.155.113.78 {
        header_up Host worldschoolingjourneys.com
        transport http {
            tls_server_name worldschoolingjourneys.com
        }
    }
}
